# Required to run the Discord bot locally
DISCORD_TOKEN=replace_with_your_bot_token
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Dashboard OAuth2 (keep secrets private)
DISCORD_CLIENT_ID=replace_with_discord_application_client_id
DISCORD_CLIENT_SECRET=replace_with_discord_oauth_client_secret
DASHBOARD_SECRET_KEY=generate_a_long_random_secret
DASHBOARD_REDIRECT_URI=https://cinnamon-c328.onrender.com/oauth/callback

# Optional persistence (recommended on ephemeral hosting)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# OWNER_USER_ID=
# PORT=8080
